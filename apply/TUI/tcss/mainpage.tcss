#input-container {
    height: 7fr;
    width: 100%;
}

#test-container{
    height: 1fr;
    width: 100%;
}

#input-list {
    width: 1fr;
    min-width: 24;
}

#input-switcher {
    width: 3fr;
    padding: 1;
}

#country-form__country-name{
    width: 3fr;
}

#country-form__country-code{
    width: 1fr;
}

#country-form__add-btn{
    margin: 1;
    width: 2fr;
}

#country-form__message{
    margin: 2;
    width: 6fr;
}

#tags-form__tag-name{
    width: 3fr;
}

#tags-form__add-btn{
    width: 1fr;
}

#tags-form__message{
    margin: 2;
}

#university-form__country-select{
    width: 1fr;
}

#university-form__university-name{
    width: 2fr;
    margin: 2;
}

#university-form__add-btn{
    width: 1fr;
}

#university-form__message{
    width: 2fr;
    margin: 2;
}